# Copy to .env before `docker compose up` (production compose requires these).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-at-least-8-chars
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Published container (matches ghcr.io/<github-owner>/<github-repo>)
# MCP_HOSTER_IMAGE=ghcr.io/OWNER/mcp_hoster:latest
# MCP_HOSTER_PULL_POLICY=missing

# Optional
# HOST_PUBLIC_URL=https://mcp.example.com
# GATEWAY_PUBLIC_URL=https://mcp.example.com/mcp
# AUTH_ALLOW_OPEN=0
# AUTH_DISABLED=0

# Sandbox mode is configured in the admin UI (Settings → Process sandbox),
# stored as host.sandbox_mode in SQLite (auto | bwrap | landlock | none).
