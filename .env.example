# Copy to .env before `docker compose up` (production compose requires bootstrap admin).
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-at-least-8-chars
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# Published image (pin a release tag in production)
# MCP_HOSTER_IMAGE=ghcr.io/secretsound/mcp_host_server:latest
# MCP_HOSTER_PULL_POLICY=missing

# Persist host data (SQLite, logs, host.json, sandboxes)
# MCP_HOSTER_DATA=./data

# Listen publish on the host (container still listens on 8080)
# HOST_PORT=8080

# Public URLs (recommended behind a reverse proxy / for SSO)
# HOST_PUBLIC_URL=https://mcp.example.com
# GATEWAY_PUBLIC_URL=https://mcp.example.com/mcp

# Database (default SQLite under /data). For Postgres:
# DATABASE_URL=postgres://user:pass@db:5432/mcp_hoster

# Seeds (optional — image/code defaults are usually enough)
# SEED_PATH=/app/seed.example.json
# Empty SEED_PATH skips demo server seeding:
# SEED_PATH=
# Library catalog defaults to GitHub; override for offline/local:
# LIBRARY_SEED_PATH=https://raw.githubusercontent.com/secretsound/mcp_host_server/main/catalog/catalog.json
# LIBRARY_SEED_PATH=/app/catalog/catalog.json

# Auth overrides (keep off in production)
# AUTH_ALLOW_OPEN=0
# AUTH_DISABLED=0

# First uvx/npx starts download runtimes/packages; raise if cold starts still time out
# MCP_BACKEND_CONNECT_TIMEOUT_MS=300000

# Sandbox mode is configured in the admin UI (Settings → Host),
# stored as host.sandbox_mode in SQLite (auto | bwrap | landlock | none).
